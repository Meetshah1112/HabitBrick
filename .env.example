# Supabase — both values are PUBLIC by design and safe to ship in the app.
# Row Level Security is what keeps user data private, not the secrecy of these.
# Find them in: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NEVER put the service_role key in this app. It bypasses Row Level Security
# entirely and would expose every user's data to anyone who unpacks the APK.
