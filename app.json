{
  "expo": {
    "name": "HabitBrick",
    "slug": "AtomicStep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.atomicstep.habitflow",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e0ba57db-3e5c-40ca-b8d0-fe7439b6673f"
      }
    },
    "owner": "aayushkj"
  }
}
